\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces EGNN message passing. Scalar messages depend only on distances (rotation-invariant). Coordinate updates use relative position vectors $(x_i - x_j)$, which rotate with the input. The combination ensures the network is E(3)-equivariant.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:egnn}{{4}{5}{EGNN message passing. Scalar messages depend only on distances (rotation-invariant). Coordinate updates use relative position vectors $(x_i - x_j)$, which rotate with the input. The combination ensures the network is E(3)-equivariant}{figure.4}{}}
