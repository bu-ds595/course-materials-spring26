\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Invariance vs.\ equivariance. (Top) Energy is invariant: rotating the molecule doesn't change its energy. (Bottom) Force is equivariant: rotating the molecule rotates the force vectors.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:inv_equiv}{{1}{2}{Invariance vs.\ equivariance. (Top) Energy is invariant: rotating the molecule doesn't change its energy. (Bottom) Force is equivariant: rotating the molecule rotates the force vectors}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Building in translation invariance}{2}{section.3}\protected@file@percent }
