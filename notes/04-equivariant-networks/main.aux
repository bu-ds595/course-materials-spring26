\@writefile{toc}{\contentsline {paragraph}{SchNet-style architecture.}{2}{section*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces SchNet-style invariant message passing. Each neighbor sends a message weighted by a learned function of distance $w(d_{ji})$. The network only sees distances, never positions, ensuring rotation and translation invariance.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:schnet}{{2}{3}{SchNet-style invariant message passing. Each neighbor sends a message weighted by a learned function of distance $w(d_{ji})$. The network only sees distances, never positions, ensuring rotation and translation invariance}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Encoding distances.}{3}{section*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Radial basis function encoding. (a) Five Gaussians centered at different distances. A vertical line marks an example distance $d = 2.7$\,\r A; dots show where it intersects each basis function. (b) The resulting encoding: a 5-dimensional vector where each entry is one basis function's activation. One scalar (distance) becomes a vector the network can process.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:rbf}{{3}{3}{Radial basis function encoding. (a) Five Gaussians centered at different distances. A vertical line marks an example distance $d = 2.7$\,\AA ; dots show where it intersects each basis function. (b) The resulting encoding: a 5-dimensional vector where each entry is one basis function's activation. One scalar (distance) becomes a vector the network can process}{figure.3}{}}
