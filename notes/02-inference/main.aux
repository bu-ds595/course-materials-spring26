\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Mode-seeking behavior. When the posterior is multimodal, VI concentrates on a single mode rather than covering all modes.}}{15}{figure.16}\protected@file@percent }
\newlabel{fig:mode_seeking}{{16}{15}{Mode-seeking behavior. When the posterior is multimodal, VI concentrates on a single mode rather than covering all modes}{figure.16}{}}
