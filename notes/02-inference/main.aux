\@writefile{toc}{\contentsline {section}{\numberline {1}You have the posterior. Now what?}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Summaries are integrals.}{1}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A two-dimensional posterior distribution. The blue shading shows probability density; darker regions are more probable. The \leavevmode {\color  {dullred}red star} marks the posterior mean $\leavevmode {\color  {dullred}\mathbb  {E}[\theta \mid x]}$. The \leavevmode {\color  {darkgreen}green contour} encloses a 95\% credible region $\leavevmode {\color  {darkgreen}\qopname  \relax m{Pr}(\theta \in R \mid x) = 0.95}$.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:banana_posterior}{{1}{1}{A two-dimensional posterior distribution. The blue shading shows probability density; darker regions are more probable. The \textcolor {dullred}{red star} marks the posterior mean $\textcolor {dullred}{\E [\theta \mid x]}$. The \textcolor {darkgreen}{green contour} encloses a 95\% credible region $\textcolor {darkgreen}{\Pr (\theta \in R \mid x) = 0.95}$}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{The problem is that we can't do these integrals.}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Two strategies (Figure\nobreakspace  {}\ref  {fig:mcmc_vs_vi_intro}).}{2}{section*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Two approaches to intractable posteriors. The blue shading shows a curved ``banana'' posterior $p(\theta \mid x)$. (Left) MCMC generates samples distributed according to the true posterior, capturing its full structure including correlations. (Right) Variational inference approximates the posterior with a simpler distribution---here a mean-field Gaussian $q_\phi (\theta ) = \mathcal  {N}(\mu , \mathrm  {diag}(\sigma ^2))$. The approximation finds the right location but cannot represent the curvature.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:mcmc_vs_vi_intro}{{2}{2}{Two approaches to intractable posteriors. The blue shading shows a curved ``banana'' posterior $p(\theta \mid x)$. (Left) MCMC generates samples distributed according to the true posterior, capturing its full structure including correlations. (Right) Variational inference approximates the posterior with a simpler distribution---here a mean-field Gaussian $q_\phi (\theta ) = \mathcal {N}(\mu , \mathrm {diag}(\sigma ^2))$. The approximation finds the right location but cannot represent the curvature}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Monte Carlo integration}{2}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Convergence.}{2}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Dimension-free convergence.}{3}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}The Metropolis algorithm}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The Metropolis algorithm in action. Starting from a uniform prior $p(\theta )$ (left), the algorithm builds a Markov chain (center) by proposing moves and accepting or rejecting them based on the posterior ratio. Accepted proposals (blue lines) move the chain to a new state; rejected proposals (red dashed) leave it in place. After many iterations, the histogram of visited states (orange bars, right) approximates the true posterior $p(\theta \mid x)$ (blue curve).}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:mh_illustration}{{3}{4}{The Metropolis algorithm in action. Starting from a uniform prior $p(\theta )$ (left), the algorithm builds a Markov chain (center) by proposing moves and accepting or rejecting them based on the posterior ratio. Accepted proposals (blue lines) move the chain to a new state; rejected proposals (red dashed) leave it in place. After many iterations, the histogram of visited states (orange bars, right) approximates the true posterior $p(\theta \mid x)$ (blue curve)}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Why does this work?}{4}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Normalizing constants cancel.}{4}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Detailed balance.}{4}{section*.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces MCMC as landscape exploration. The surface represents a posterior distribution over two parameters. The algorithm proposes moves (arrows), accepts those that go uphill or pass a random test when going downhill, and traces out a path that spends more time in high-probability regions.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:mcmc_landscape}{{4}{5}{MCMC as landscape exploration. The surface represents a posterior distribution over two parameters. The algorithm proposes moves (arrows), accepts those that go uphill or pass a random test when going downhill, and traces out a path that spends more time in high-probability regions}{figure.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Tuning and convergence}{5}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Autocorrelation.}{5}{section*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Detailed balance visualized. In equilibrium, the probability flow from state A to state B exactly balances the flow from B to A. State A has higher probability (darker), so transitions $A \to B$ are always accepted, but $B \to A$ is only accepted with probability $p(A)/p(B)$. The flows balance: $p(A) \cdot T(A \to B) = p(B) \cdot T(B \to A)$. This ensures the chain spends time at each $\theta $ proportional to $p(\theta \mid x)$.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:acceptance_intuition}{{5}{6}{Detailed balance visualized. In equilibrium, the probability flow from state A to state B exactly balances the flow from B to A. State A has higher probability (darker), so transitions $A \to B$ are always accepted, but $B \to A$ is only accepted with probability $p(A)/p(B)$. The flows balance: $p(A) \cdot T(A \to B) = p(B) \cdot T(B \to A)$. This ensures the chain spends time at each $\theta $ proportional to $p(\theta \mid x)$}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The step size tradeoff. (a) Step size too small: nearly all proposals are accepted, but exploration is slow. (b) Step size too large: most proposals land in low-probability regions and are rejected. (c) Step size well-tuned: efficient exploration.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:step_size}{{6}{6}{The step size tradeoff. (a) Step size too small: nearly all proposals are accepted, but exploration is slow. (b) Step size too large: most proposals land in low-probability regions and are rejected. (c) Step size well-tuned: efficient exploration}{figure.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}The failure of random walks in high dimensions}{6}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The typical set in high dimensions. For a $d$-dimensional Gaussian, most probability mass lies not at the mode (where density is highest) but in a thin shell at radius $\sqrt  {d}$. Volume grows rapidly with radius, overwhelming the density decay.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:typical_set}{{7}{7}{The typical set in high dimensions. For a $d$-dimensional Gaussian, most probability mass lies not at the mode (where density is highest) but in a thin shell at radius $\sqrt {d}$. Volume grows rapidly with radius, overwhelming the density decay}{figure.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Hamiltonian Monte Carlo}{7}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}The key idea}{7}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}The physics picture}{7}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Why gradients help. (Left) A random walk proposes moves uniformly in all directions. Most directions point off the high-probability region and will be rejected. (Right) The gradient $\nabla \qopname  \relax o{log}p(\theta )$ points toward higher probability; directions perpendicular to the gradient are tangent to contours---exactly where we want to move to explore efficiently.}}{8}{figure.8}\protected@file@percent }
\newlabel{fig:gradient_information}{{8}{8}{Why gradients help. (Left) A random walk proposes moves uniformly in all directions. Most directions point off the high-probability region and will be rejected. (Right) The gradient $\nabla \log p(\theta )$ points toward higher probability; directions perpendicular to the gradient are tangent to contours---exactly where we want to move to explore efficiently}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}The algorithm}{8}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Metropolis random walk vs.\ Hamiltonian Monte Carlo. (a) Metropolis: the chain diffuses slowly, taking many small steps. (b) HMC: gradient-informed trajectories make long, directed moves across the posterior.}}{9}{figure.9}\protected@file@percent }
\newlabel{fig:hmc_vs_rw}{{9}{9}{Metropolis random walk vs.\ Hamiltonian Monte Carlo. (a) Metropolis: the chain diffuses slowly, taking many small steps. (b) HMC: gradient-informed trajectories make long, directed moves across the posterior}{figure.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Diagnostics}{9}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Trace plots.}{9}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Multiple chains.}{9}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Effective sample size.}{9}{section*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces MCMC convergence diagnostics via trace plots. (a) Good mixing: the chain fluctuates around a stable mean with no visible trends---this is what we want. (b) Poor mixing: a slow upward drift indicates the chain hasn't reached equilibrium; more samples or better tuning is needed. (c) Multiple chains: running several chains from different starting points that converge to the same distribution is strong evidence of convergence. The $\hat  {R}$ statistic formalizes this by comparing within-chain to between-chain variance.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:convergence_diagnostics}{{10}{10}{MCMC convergence diagnostics via trace plots. (a) Good mixing: the chain fluctuates around a stable mean with no visible trends---this is what we want. (b) Poor mixing: a slow upward drift indicates the chain hasn't reached equilibrium; more samples or better tuning is needed. (c) Multiple chains: running several chains from different starting points that converge to the same distribution is strong evidence of convergence. The $\hat {R}$ statistic formalizes this by comparing within-chain to between-chain variance}{figure.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Visualizing high-dimensional posteriors}{10}{section.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Corner plots.}{10}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Variational inference}{10}{section.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The idea.}{10}{section*.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Corner plot from the Planck satellite's measurement of the cosmic microwave background (CMB)---the afterglow of the Big Bang. The Planck collaboration ran MCMC to estimate cosmological parameters from temperature and polarization fluctuations in the CMB; samples shown here are from the PR4 data release. Parameters shown: Hubble constant $H_0$ (expansion rate today), matter density $\Omega _m$, fluctuation amplitude $\sigma _8$, and spectral index $n_s$ (how fluctuations vary with scale). The $H_0$--$\Omega _m$ anticorrelation arises because both affect the angular diameter distance to the CMB. Contours show 68\% and 95\% credible regions. Data from \href  {https://arxiv.org/abs/2302.12911}{Lemos \& Lewis (2023)}.}}{11}{figure.11}\protected@file@percent }
\newlabel{fig:corner_cosmology}{{11}{11}{Corner plot from the Planck satellite's measurement of the cosmic microwave background (CMB)---the afterglow of the Big Bang. The Planck collaboration ran MCMC to estimate cosmological parameters from temperature and polarization fluctuations in the CMB; samples shown here are from the PR4 data release. Parameters shown: Hubble constant $H_0$ (expansion rate today), matter density $\Omega _m$, fluctuation amplitude $\sigma _8$, and spectral index $n_s$ (how fluctuations vary with scale). The $H_0$--$\Omega _m$ anticorrelation arises because both affect the angular diameter distance to the CMB. Contours show 68\% and 95\% credible regions. Data from \href {https://arxiv.org/abs/2302.12911}{Lemos \& Lewis (2023)}}{figure.11}{}}
\@writefile{toc}{\contentsline {paragraph}{Measuring closeness.}{11}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The geometry of variational inference. The outer box is the space of all distributions; the shaded region is the variational family $\mathcal  {Q}$. The true posterior $p(\theta \mid x)$ lies outside $\mathcal  {Q}$. Starting from an initial approximation $q_0$, we optimize to find $q^*$---the member of $\mathcal  {Q}$ closest to the true posterior, minimizing the KL divergence (dashed).}}{12}{figure.12}\protected@file@percent }
\newlabel{fig:vi_geometry}{{12}{12}{The geometry of variational inference. The outer box is the space of all distributions; the shaded region is the variational family $\mathcal {Q}$. The true posterior $p(\theta \mid x)$ lies outside $\mathcal {Q}$. Starting from an initial approximation $q_0$, we optimize to find $q^*$---the member of $\mathcal {Q}$ closest to the true posterior, minimizing the KL divergence (dashed)}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces KL divergence measures how different two distributions are. (Left) When $q$ and $p$ are similar, KL is small. (Right) When $q$ places mass where $p$ is nearly zero, KL is large---the $\qopname  \relax o{log}(q/p)$ term blows up.}}{12}{figure.13}\protected@file@percent }
\newlabel{fig:kl_divergence}{{13}{12}{KL divergence measures how different two distributions are. (Left) When $q$ and $p$ are similar, KL is small. (Right) When $q$ places mass where $p$ is nearly zero, KL is large---the $\log (q/p)$ term blows up}{figure.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}The evidence lower bound (ELBO)}{12}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What we can and can't compute.}{12}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {11}The two forces in the ELBO}{13}{section.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces The two terms in the ELBO. The expected log-likelihood rewards $q$ for placing mass where the data are well-explained. The KL from prior penalizes deviation from prior beliefs.}}{13}{figure.14}\protected@file@percent }
\newlabel{fig:elbo_decomposition}{{14}{13}{The two terms in the ELBO. The expected log-likelihood rewards $q$ for placing mass where the data are well-explained. The KL from prior penalizes deviation from prior beliefs}{figure.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {12}Optimizing the ELBO}{13}{section.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces VI on the banana posterior. (Top left) MCMC samples capture the curved shape. (Top right) Evolution of the mean-field Gaussian $q$ during optimization---it finds the right location but cannot represent the curvature. (Bottom) The ELBO increases during optimization.}}{14}{figure.15}\protected@file@percent }
\newlabel{fig:vi_optimization_detail}{{15}{14}{VI on the banana posterior. (Top left) MCMC samples capture the curved shape. (Top right) Evolution of the mean-field Gaussian $q$ during optimization---it finds the right location but cannot represent the curvature. (Bottom) The ELBO increases during optimization}{figure.15}{}}
