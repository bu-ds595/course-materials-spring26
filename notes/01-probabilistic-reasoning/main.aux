\newlabel{fig:distributions}{{11}{12}{Common probability distributions. Top row: Gaussian (continuous, symmetric), Poisson (discrete counts), Binomial (number of successes). Bottom row: Categorical (discrete outcomes), Uniform (flat over interval)}{figure.11}{}}
