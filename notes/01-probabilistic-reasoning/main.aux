\@writefile{toc}{\contentsline {section}{\numberline {1}Why be probabilistic?}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Notation and probability basics}{1}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Density vs.\ probability.}{1}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Conditional probability.}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Independence.}{2}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Marginalization.}{2}{section*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Marginalization visualized. The central contours show a joint distribution $p(x,y)$. The marginal $p(x)$ (top) is obtained by integrating out $y$; the marginal $p(y)$ (right) by integrating out $x$.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:marginalization}{{1}{2}{Marginalization visualized. The central contours show a joint distribution $p(x,y)$. The marginal $p(x)$ (top) is obtained by integrating out $y$; the marginal $p(y)$ (right) by integrating out $x$}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Expectation values.}{2}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Product rule.}{2}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Bayes' theorem.}{2}{section*.7}\protected@file@percent }
\newlabel{eq:bayes}{{2.5}{2}{Bayes' theorem}{equation.2.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Forward vs.\ inverse problems}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Forward vs.\ inverse problems. The forward direction (simulation) samples data given parameters: $x \sim p(x \mid \theta )$. The inverse direction (inference) is ill-posed: given data, we want a distribution over parameters $p(\theta \mid x)$. Bayesian inference provides a principled framework for this inversion.}}{3}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}The data-generating process: a worked example}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Setting.}{3}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The forward model.}{4}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Fitting a line to noisy data. Each measurement has Gaussian uncertainty $\sigma $ (shown as error bars). The gray dashed line is the true relationship; the orange line is the maximum likelihood estimate.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:line_fit}{{3}{4}{Fitting a line to noisy data. Each measurement has Gaussian uncertainty $\sigma $ (shown as error bars). The gray dashed line is the true relationship; the orange line is the maximum likelihood estimate}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}The likelihood function}{4}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Maximum likelihood estimation}{5}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The MLE.}{5}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Log-likelihoods.}{5}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Profile likelihoods.}{5}{section*.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Profile likelihood for the slope parameter $m$, with the intercept $c$ profiled out. The curve shows how well each value of $m$ can fit the data (after optimizing over $c$). The peak marks the MLE of $m$.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:profile}{{4}{5}{Profile likelihood for the slope parameter $m$, with the intercept $c$ profiled out. The curve shows how well each value of $m$ can fit the data (after optimizing over $c$). The peak marks the MLE of $m$}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Likelihood ratios.}{5}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Quantifying uncertainty.}{6}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}The posterior distribution}{6}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Bayesian inference: the prior (left) encodes initial beliefs, the likelihood (middle) peaks where data are probable, the posterior (right) combines both.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:bayes}{{5}{6}{Bayesian inference: the prior (left) encodes initial beliefs, the likelihood (middle) peaks where data are probable, the posterior (right) combines both}{figure.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Sequential updating.}{6}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sequential Bayesian updating. Starting from the prior $p(\theta )$, each observation sharpens the posterior: $p(\theta ) \to p(\theta \mid x_1) \to p(\theta \mid x_1, x_2) \to \cdots  $. The orange dashed line marks the true value.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:posterior_evolution}{{6}{7}{Sequential Bayesian updating. Starting from the prior $p(\theta )$, each observation sharpens the posterior: $p(\theta ) \to p(\theta \mid x_1) \to p(\theta \mid x_1, x_2) \to \cdots $. The orange dashed line marks the true value}{figure.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Priors encode domain knowledge.}{7}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Worked example.}{7}{section*.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Bayesian inference for line fitting. (a) Data with measurement uncertainties; teal lines show the range of fits consistent with the data, each a line $x = mt + c$ for a different $(m, c)$ pair drawn from the posterior. (b) Joint posterior over slope $m$ and intercept $c$, showing the characteristic anti-correlation: steeper slopes require lower intercepts.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:line_posterior}{{7}{7}{Bayesian inference for line fitting. (a) Data with measurement uncertainties; teal lines show the range of fits consistent with the data, each a line $x = mt + c$ for a different $(m, c)$ pair drawn from the posterior. (b) Joint posterior over slope $m$ and intercept $c$, showing the characteristic anti-correlation: steeper slopes require lower intercepts}{figure.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Using the posterior.}{8}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Parameter degeneracy.}{8}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Bayesian model comparison}{8}{section.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The evidence.}{8}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Bayes factors.}{8}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Example: linear vs.\ cubic.}{8}{section*.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Corner plot for the line-fitting posterior. Diagonal: marginal distributions $p(m \mid \text  {data})$ and $p(c \mid \text  {data})$ with 68\% credible intervals (shaded). Off-diagonal: joint posterior with 68\% and 95\% credible regions (contours containing 68\% and 95\% of the probability mass).}}{9}{figure.8}\protected@file@percent }
\newlabel{fig:corner}{{8}{9}{Corner plot for the line-fitting posterior. Diagonal: marginal distributions $p(m \mid \text {data})$ and $p(c \mid \text {data})$ with 68\% credible intervals (shaded). Off-diagonal: joint posterior with 68\% and 95\% credible regions (contours containing 68\% and 95\% of the probability mass)}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Model comparison for line-fitting data. (a) Linear ($y = a + bx$) and cubic ($y = a + bx + cx^2 + dx^3$) fits to the same data; both fit reasonably well. (b) Log evidence $\qopname  \relax o{log}p(\text  {data} \mid \mathcal  {M})$ for each model. The difference $\Delta = 2.3$ corresponds to a Bayes factor of $\approx 10$ favoring the simpler linear model.}}{9}{figure.9}\protected@file@percent }
\newlabel{fig:model_comparison}{{9}{9}{Model comparison for line-fitting data. (a) Linear ($y = a + bx$) and cubic ($y = a + bx + cx^2 + dx^3$) fits to the same data; both fit reasonably well. (b) Log evidence $\log p(\text {data} \mid \mathcal {M})$ for each model. The difference $\Delta = 2.3$ corresponds to a Bayes factor of $\approx 10$ favoring the simpler linear model}{figure.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Automatic Occam's razor.}{10}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Bayesian Occam's razor. A simple model (blue) concentrates its prior probability in a narrow range of possible datasets, while a complex model (magenta) spreads probability over many more possibilities. At the observed data (dashed line), the simple model assigns higher probability because it ``expected'' this outcome more strongly.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:occam}{{10}{10}{Bayesian Occam's razor. A simple model (blue) concentrates its prior probability in a narrow range of possible datasets, while a complex model (magenta) spreads probability over many more possibilities. At the observed data (dashed line), the simple model assigns higher probability because it ``expected'' this outcome more strongly}{figure.10}{}}
