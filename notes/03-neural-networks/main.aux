\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces A recurrent neural network unrolled through time. The same function (with shared weights) processes each input $x_t$ and the previous hidden state $h_{t-1}$ to produce the next hidden state $h_t$. The final state $h_T$ summarizes the entire sequence.}}{10}{figure.9}\protected@file@percent }
\newlabel{fig:rnn}{{9}{10}{A recurrent neural network unrolled through time. The same function (with shared weights) processes each input $x_t$ and the previous hidden state $h_{t-1}$ to produce the next hidden state $h_t$. The final state $h_T$ summarizes the entire sequence}{figure.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Sets and graphs $\to $ Deep Sets and GNNs}{10}{subsection.5.3}\protected@file@percent }
