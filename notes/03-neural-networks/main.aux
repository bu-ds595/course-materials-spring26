\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces A multilayer perceptron with two hidden layers. Each layer applies a linear transformation followed by a nonlinearity. All neurons in adjacent layers are connected (``fully connected'').}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:mlp}{{2}{3}{A multilayer perceptron with two hidden layers. Each layer applies a linear transformation followed by a nonlinearity. All neurons in adjacent layers are connected (``fully connected'')}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{What can nonlinearity do?}{3}{section*.6}\protected@file@percent }
