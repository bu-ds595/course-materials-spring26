\@writefile{toc}{\contentsline {paragraph}{Per-element outputs (equivariance).}{10}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Deep Sets architecture. Each element $x_i$ passes through the same network $\phi $ (weight sharing). Embeddings are summed (a symmetric operation), then processed by $\rho $ to produce the output. Reordering the inputs doesn't change the sum, so the output is permutation-invariant.}}{11}{figure.10}\protected@file@percent }
\newlabel{fig:deep_sets}{{10}{11}{Deep Sets architecture. Each element $x_i$ passes through the same network $\phi $ (weight sharing). Embeddings are summed (a symmetric operation), then processed by $\rho $ to produce the output. Reordering the inputs doesn't change the sum, so the output is permutation-invariant}{figure.10}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.3.1}GNNs: adding relational structure}{11}{subsubsection.5.3.1}\protected@file@percent }
