\newlabel{fig:graph_attention}{{12}{13}{Graph attention learns which neighbors matter. Left: standard GNN weights all neighbors equally. Right: attention weights neighbors by learned relevance scores $\alpha _{ji}$, allowing the network to focus on the most informative connections}{figure.12}{}}
