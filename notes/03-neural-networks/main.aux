\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Message passing in three stages. (1) Start with node features on a graph. (2) Each node computes messages from its neighbors using a learned function $\psi $. (3) Messages are aggregated (summed) and combined with the node's own features to produce updated representations.}}{11}{figure.11}\protected@file@percent }
\newlabel{fig:gnn_detailed}{{11}{11}{Message passing in three stages. (1) Start with node features on a graph. (2) Each node computes messages from its neighbors using a learned function $\psi $. (3) Messages are aggregated (summed) and combined with the node's own features to produce updated representations}{figure.11}{}}
