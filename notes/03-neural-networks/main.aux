\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Attention patterns across architectures. Dark nodes are queries; arrows show which inputs contribute. \textbf  {MLP}: all inputs, fixed weights. \textbf  {CNN}: local inputs, fixed weights (same kernel everywhere). \textbf  {GNN}: graph neighbors, learned weights. \textbf  {Transformer}: all inputs, learned weights. Arrow thickness indicates attention weight.}}{13}{figure.13}\protected@file@percent }
\newlabel{fig:attention_patterns}{{13}{13}{Attention patterns across architectures. Dark nodes are queries; arrows show which inputs contribute. \textbf {MLP}: all inputs, fixed weights. \textbf {CNN}: local inputs, fixed weights (same kernel everywhere). \textbf {GNN}: graph neighbors, learned weights. \textbf {Transformer}: all inputs, learned weights. Arrow thickness indicates attention weight}{figure.13}{}}
