\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Residual (skip) connections. Left: a standard network computes $F(x)$. Right: a residual block computes $F(x) + x$. The skip connection provides a direct path for gradients, enabling training of very deep networks.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:residual}{{4}{4}{Residual (skip) connections. Left: a standard network computes $F(x)$. Right: a residual block computes $F(x) + x$. The skip connection provides a direct path for gradients, enabling training of very deep networks}{figure.4}{}}
